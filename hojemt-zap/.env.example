# Copie para /etc/hojemt-zap.env e preencha.

# Porta local da ponte (o webhook do Ghost aponta para ela)
PORT=3900

# Provedor de WhatsApp: waha | evolution
WA_PROVIDER=waha

# URL base do WAHA/Evolution (no mesmo servidor: localhost)
WA_URL=http://localhost:8080

# Chave de API do WAHA (X-Api-Key) ou da Evolution (apikey)
WA_API_KEY=troque-esta-chave

# Nome da sessão (WAHA) ou da instância (Evolution)
WA_SESSION=default

# Destinos separados por vírgula:
#   grupo:  120363XXXXXXXXXXX@g.us
#   canal:  XXXXXXXXXXXXXXXXX@newsletter
#   pessoa: 5565XXXXXXXX@c.us
WA_CHAT_IDS=

# Token que protege o webhook (invente um valor longo)
WEBHOOK_TOKEN=troque-este-token
