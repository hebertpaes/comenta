{
  "name": "comenta",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo do Comenta — plataforma de atendimento multicanal (comenta.com.br)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "saas/api",
    "saas/web",
    "site",
    "content"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "dev:api": "npm run dev -w @comenta/api",
    "dev:web": "npm run dev -w @comenta/web",
    "dev:site": "npm run dev -w @comenta/site",
    "dev:editor": "npm run dev -w @comenta/editor"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
