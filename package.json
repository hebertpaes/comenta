{
  "name": "comenta",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo do Comenta — plataforma de atendimento multicanal (comenta.com.br)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "saas/api",
    "saas/web",
    "site",
    "content"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev -w @comenta/api",
    "dev:web": "npm run dev -w @comenta/web",
    "dev:site": "npm run dev -w @comenta/site",
    "dev:editor": "npm run dev -w @comenta/editor"
  }
}
