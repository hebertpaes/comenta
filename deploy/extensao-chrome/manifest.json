{
  "manifest_version": 3,
  "name": "Comenta — Hub local",
  "version": "1.0.0",
  "description": "Abre e monitora todos os serviços do Comenta rodando no seu Mac: painel, site, API, Ghost, n8n, NocoDB, Metabase e Moodle.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Comenta — Hub local"
  },
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"]
}
