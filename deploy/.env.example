# Comenta 1.0 — variáveis do deploy (deploy/docker-compose.yml).
# Copie para .env e preencha. NUNCA versione o .env real.

# --- Domínio raiz ---
# Fonte única: o compose monta APP_URL, API_URL, CORS_ORIGINS e as NEXT_PUBLIC_*
# do build do site a partir daqui (app.DOMAIN, api.DOMAIN, blog.DOMAIN).
# O bootstrap.sh reescreve esta linha com o DOMAIN que recebeu.
DOMAIN=intsoft.com.br

# --- Site / landing + chat ---
# Fonte do carrossel de notícias. Sem efeito na 1.0: nenhuma página renderiza o carrossel.
NEXT_PUBLIC_NEWS_SOURCE=https://hojemt.com.br
# Sem efeito na 1.0: o compose passa a variável ao build, mas nenhum arquivo do
# site a lê (não existe botão "Continuar no WhatsApp").
NEXT_PUBLIC_WHATSAPP=5566999999999

# --- Banco de dados / cache ---
DB_PASSWORD=troque-esta-senha-forte
REDIS_PASSWORD=troque-esta-senha-forte

# --- Ghost (blog/CMS) ---
GHOST_URL=https://blog.intsoft.com.br
GHOST_DB_PASSWORD=troque-esta-senha-forte

# --- JWT (gere cada um com: openssl rand -hex 32) ---
JWT_SECRET=
# NÃO USADO pelo código hoje (o refresh token é aleatório e fica como hash no
# banco), mas o docker-compose.yml exige um valor: preencha mesmo assim.
JWT_REFRESH_SECRET=

# --- IA da API (opcional: Claude ou Gemini) ---
# Claude se ANTHROPIC_API_KEY for válida (sk-ant-…); senão Gemini; sem chave
# nenhuma, as rotas de IA respondem 503.
ANTHROPIC_API_KEY=
AI_MODEL_CLASSIFY=claude-haiku-4-5
AI_MODEL_SUMMARIZE=claude-haiku-4-5
AI_MODEL_SUGGEST=claude-sonnet-5
# Chat do site (POST /widget/ai). O compose repassa; padrão do compose: claude-sonnet-5
# AI_MODEL_CHAT=claude-sonnet-5
# Autoatendimento por IA (automação "ai"). ATENÇÃO: o compose de hoje NÃO repassa
# esta variável, e o padrão do código é gemini-2.0-flash, que a Anthropic recusa.
# AI_MODEL_AUTOREPLY=claude-haiku-4-5
# Gemini para a API: GEMINI_API_KEY (definida mais abaixo, na seção do robô de
# conteúdo) ou GOOGLE_AI_API_KEY, e o modelo em GOOGLE_AI_MODEL (padrão
# gemini-2.0-flash). O compose de hoje NÃO repassa nenhuma delas à API.
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_MODEL=gemini-2.0-flash

# --- API: outras variáveis que o código lê ---
# Exceto WHATSAPP_MODE, o docker-compose.yml de hoje NÃO repassa estas
# variáveis ao container da API: só valem se você acrescentá-las ao compose
# (ou ao compose.local.yml, que já repassa as META_*).
#
# WhatsApp: baileys (padrão) = conexão real por QR | demo = QR e conexão simulados
# WHATSAPP_MODE=baileys
# Pasta das credenciais pareadas. No compose é fixa em /data/wa (volume wa_data).
# WHATSAPP_DATA_DIR=/data/wa
# 1 = pede o histórico completo ao parear (traz a agenda do aparelho; pesado)
# WHATSAPP_FULL_SYNC=0
# Instagram Direct / Messenger: app secret da Meta (confere o HMAC do webhook) e
# o token de verificação do webhook /webhooks/meta. Cada conexão também pode
# ter os dois no config, via PATCH /channels/:id na API (o painel não tem esses
# campos).
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# Empresa que atende o chat do site; sem ela, vale a primeira empresa cadastrada.
# WIDGET_COMPANY_ID=
# Pausa entre envios de campanha (ms) só quando a campanha tem intervalo mínimo
# e máximo iguais a 0 (o padrão de campanha é 5 a 15 s). Padrão: 700
# CAMPAIGN_SEND_GAP_MS=700
# Seed: com NODE_ENV=production (o caso do compose) só os planos são criados;
# SEED_DEMO=true força a empresa e os usuários de demonstração, com o admin
# admin@comenta.com.br e a senha SEED_ADMIN_PASSWORD (padrão comenta123).
# SEED_DEMO=false
# SEED_ADMIN_PASSWORD=

# --- Blog / robô de conteúdo (Ghost) ---
# Ghost → Settings → Integrations → Add custom integration → copie a Admin API Key (id:secret)
GHOST_ADMIN_API_KEY=
# Onde o robô encontra o Ghost. Container do compose: http://ghost:2368.
# Ghost nativo do servidor (ghost-cli, fora do Docker): http://host.docker.internal:2368
GHOST_ADMIN_URL=
# Ilustração realista das Curtas/charges (content/ilustrar.mjs). Chave: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Jev (TypeSafe): chave em https://console.typesafe.ai/keys (opcional; liga content/lib/jev.mjs)
TYPESAFE_API_KEY=
# Kit da redação (content/README.md): bancos de imagem opcionais e Instagram Graph API
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
IG_USER_ID=
IG_ACCESS_TOKEN=
# Backup para o Google Drive via rclone (ex.: gdrive:Backups/HojeMT)
RCLONE_REMOTE=
# 1 = publica direto | 0 = cria como RASCUNHO para revisão (padrão, mais seguro)
BLOG_AUTOPUBLISH=0
# >0 = roda em loop a cada N minutos (0 = roda uma vez e sai)
BLOG_INTERVAL_MIN=0
# nº de itens por feed a cada rodada
BLOG_PER_FEED=3

# Integrações de cursos (Hotmart / ABACS) — só aqui, nunca no código.
# Os valores antigos ficaram expostos no repositório público: gere novos
# no painel do Hotmart (hottok) e com a ABACS (token) antes de preencher.
HOTMART_HOTTOK=
ABACS_TOKEN=
