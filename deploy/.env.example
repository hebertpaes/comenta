# Copie para .env e preencha. NUNCA versione o .env real.

# --- Domínio raiz ---
# Fonte única: o compose monta APP_URL, API_URL, CORS_ORIGINS e as NEXT_PUBLIC_*
# do build do site a partir daqui (app.DOMAIN, api.DOMAIN, blog.DOMAIN).
# O bootstrap.sh reescreve esta linha com o DOMAIN que recebeu.
DOMAIN=intsoft.com.br

# --- Site / landing + chat ---
NEXT_PUBLIC_NEWS_SOURCE=https://hojemt.com.br
# WhatsApp do "Continuar no WhatsApp" (só dígitos, com DDI+DDD)
NEXT_PUBLIC_WHATSAPP=5566999999999

# --- Banco de dados / cache ---
DB_PASSWORD=troque-esta-senha-forte
REDIS_PASSWORD=troque-esta-senha-forte

# --- Ghost (blog/CMS) ---
GHOST_URL=https://blog.intsoft.com.br
GHOST_DB_PASSWORD=troque-esta-senha-forte

# --- JWT (gere cada um com: openssl rand -hex 32) ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- IA Claude (opcional) ---
ANTHROPIC_API_KEY=
AI_MODEL_CLASSIFY=claude-haiku-4-5
AI_MODEL_SUMMARIZE=claude-haiku-4-5
AI_MODEL_SUGGEST=claude-sonnet-5

# --- Blog / robô de conteúdo (Ghost) ---
# Ghost → Settings → Integrations → Add custom integration → copie a Admin API Key (id:secret)
GHOST_ADMIN_API_KEY=
# Onde o robô encontra o Ghost. Container do compose: http://ghost:2368.
# Ghost nativo do servidor (ghost-cli, fora do Docker): http://host.docker.internal:2368
GHOST_ADMIN_URL=
# 1 = publica direto | 0 = cria como RASCUNHO para revisão (padrão, mais seguro)
BLOG_AUTOPUBLISH=0
# >0 = roda em loop a cada N minutos (0 = roda uma vez e sai)
BLOG_INTERVAL_MIN=0
# nº de itens por feed a cada rodada
BLOG_PER_FEED=3
