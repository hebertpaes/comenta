# Comenta 1.0 — API
# A API não carrega este arquivo sozinha: exporte-o antes de rodar
# (set -a && . ./.env && set +a). Em produção o docker-compose injeta as variáveis.
NODE_ENV=development
PORT=4000
APP_URL=https://app.intsoft.com.br
API_URL=https://api.intsoft.com.br

DATABASE_URL=postgresql://comenta:comenta123@localhost:5432/comenta_saas
REDIS_URL=redis://:comenta123@localhost:6379

# Gere com: openssl rand -base64 48
JWT_SECRET=troque-este-segredo
# NÃO USADO hoje: o refresh token é um valor aleatório guardado como hash no banco.
# O config ainda lê a variável (e o compose a exige), mas nada a usa.
JWT_REFRESH_SECRET=troque-este-segredo-tambem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS (origens separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,https://app.intsoft.com.br

# --- IA (opcional: Claude ou Gemini) ---
# Ordem: Claude se ANTHROPIC_API_KEY for válida (sk-ant-…); senão Gemini.
# Sem nenhuma chave válida, as rotas /ai respondem 503.
ANTHROPIC_API_KEY=
# Modelos usados com a Anthropic. Os padrões NO CÓDIGO são nomes Gemini
# (gemini-2.0-flash / gemini-1.5-flash), que a Anthropic recusa: com chave
# Anthropic, defina as cinco variáveis abaixo.
AI_MODEL_CLASSIFY=claude-haiku-4-5
AI_MODEL_SUMMARIZE=claude-haiku-4-5
AI_MODEL_SUGGEST=claude-sonnet-5
# Autoatendimento por IA (automação do tipo "ai").
# AI_MODEL_AUTOREPLY=claude-haiku-4-5
# Assistente do chat do site (POST /widget/ai).
# AI_MODEL_CHAT=claude-sonnet-5

# Gemini (usado quando não há chave Anthropic válida). Basta uma das duas chaves.
# Chave em https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=
# Modelo do Gemini (as AI_MODEL_* acima não valem para o Gemini). Padrão: gemini-2.0-flash
# GOOGLE_AI_MODEL=gemini-2.0-flash

# --- Instagram Direct / Facebook Messenger (Meta) ---
# App secret do app da Meta: confere a assinatura X-Hub-Signature-256 do webhook.
# META_APP_SECRET=
# Token que você inventa e cola no painel da Meta ao cadastrar o webhook /webhooks/meta.
# META_VERIFY_TOKEN=
# (Cada conexão também pode ter appSecret/verifyToken próprios no config, via
# PATCH /channels/:id na API; o painel não tem esses campos.)

# --- WhatsApp (Baileys) ---
# baileys (padrão) = conexão real por QR | demo = QR e conexão simulados, nada é enviado
# WHATSAPP_MODE=baileys
# Pasta das credenciais pareadas (uma subpasta por conexão). Padrão: /data/wa
# WHATSAPP_DATA_DIR=/data/wa
# 1 = pede o histórico completo ao parear (traz a agenda do aparelho; pesado,
# pode deixar a sessão instável). Desligado por padrão.
# WHATSAPP_FULL_SYNC=0

# --- Chat do site (widget) ---
# Empresa que atende o chat do site. Sem ela, vale a primeira empresa cadastrada.
# WIDGET_COMPANY_ID=

# --- Campanhas ---
# Pausa entre envios (ms) usada só quando a campanha tem intervalo mínimo e
# máximo iguais a 0 (sem configuração própria, vale o padrão de 5 a 15 s).
# Padrão: 700
# CAMPAIGN_SEND_GAP_MS=700

# --- Seed (npm run db:seed) ---
# Senha do admin@comenta.com.br de demonstração. Padrão: comenta123
# SEED_ADMIN_PASSWORD=
# true = cria a empresa e os usuários de demonstração mesmo com NODE_ENV=production
# SEED_DEMO=false

# Integrações de cursos (Hotmart / ABACS) — só aqui, nunca no código.
# Os valores antigos ficaram expostos no repositório público: gere novos
# no painel do Hotmart (hottok) e com a ABACS (token) antes de preencher.
HOTMART_HOTTOK=
ABACS_TOKEN=
