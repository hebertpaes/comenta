# Comenta SaaS — API
NODE_ENV=development
PORT=4000
APP_URL=https://app.comenta.com.br
API_URL=https://api.comenta.com.br

DATABASE_URL=postgresql://comenta:comenta123@localhost:5432/comenta_saas
REDIS_URL=redis://:comenta123@localhost:6379

# Gere com: openssl rand -base64 48
JWT_SECRET=troque-este-segredo
JWT_REFRESH_SECRET=troque-este-segredo-tambem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS (origens separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,https://app.comenta.com.br

# --- IA (Claude / Anthropic) ---
# Chave da API Anthropic. Sem ela, os endpoints /ai respondem 503.
ANTHROPIC_API_KEY=
# Modelos por tarefa (padrões para custo baixo em alto volume).
# Suba para claude-opus-4-8 se quiser máxima qualidade.
AI_MODEL_CLASSIFY=claude-haiku-4-5
AI_MODEL_SUMMARIZE=claude-haiku-4-5
AI_MODEL_SUGGEST=claude-sonnet-5
