{
  "name": "@comenta/api",
  "version": "1.0.0",
  "description": "Comenta SaaS — API de atendimento multicanal (comenta.com.br)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "smoke": "bash test/smoke.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@comenta/shared": "*",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.1.0",
    "@whiskeysockets/baileys": "^6.7.23",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.38.2",
    "fastify": "^5.2.0",
    "groq-sdk": "^1.5.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^7.4.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
