    "value": "<!-- Google Analytics 4 (G-FKD65M01H9) com Consent Mode v2 — só mede depois do aceite LGPD -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-FKD65M01H9\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n  // por padrão nada é medido: respeita a LGPD até o leitor decidir\n  gtag('consent', 'default', {\n    ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',\n    analytics_storage: 'denied', wait_for_update: 500\n  });\n  gtag('config', 'G-FKD65M01H9', { anonymize_ip: true });\n  (function () {\n    function liberar() {\n      gtag('consent', 'update', {\n        analytics_storage: 'granted', ad_storage: 'granted',\n        ad_user_data: 'granted', ad_personalization: 'granted'\n      });\n    }\n    try {\n      if (localStorage.getItem('hmt_cookies') === 'todos') liberar();\n    } catch (e) {}\n    // o banner grava a escolha; ouvimos o clique para liberar na hora\n    document.addEventListener('click', function (ev) {\n      var b = ev.target && ev.target.closest && ev.target.closest('#hmt-ck-aceitar');\n      if (b) setTimeout(liberar, 60);\n    }, true);\n  })();\n</script>\n"
